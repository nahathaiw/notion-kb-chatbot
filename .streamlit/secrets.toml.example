# Streamlit secrets — used when deployed on Streamlit Community Cloud.
# On Cloud: paste these (with real values) into the app's Settings -> Secrets.
# Locally: copy this file to `.streamlit/secrets.toml` (gitignored) if you'd
# rather use it instead of `.env`. Never commit the real file.

OPENAI_API_KEY = "sk-..."

# Only needed for the "Notion workspace" source.
NOTION_API_KEY = "ntn_..."

# Password gate for the hosted site. Pick something strong — anyone with this
# can query your private Notion pages and spend your OpenAI credits.
APP_PASSWORD = "change-me-to-something-strong"
