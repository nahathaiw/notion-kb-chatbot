# Copy this file to `.env` and paste your real keys. `.env` is gitignored.

# Required — OpenAI key for embeddings + generation.
OPENAI_API_KEY=sk-...

# Optional — only needed for the "Notion workspace" source in the web app.
# Create an integration at https://www.notion.so/my-integrations, copy its
# Internal Integration Secret, then share pages with it (page -> ... -> Connections).
NOTION_API_KEY=secret_...

# Optional — password gate for the web app. If set, users must enter it to use
# the app. Leave unset for open local use; REQUIRED before hosting publicly.
APP_PASSWORD=change-me
